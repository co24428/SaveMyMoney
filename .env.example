# --- Required ---
# The password you type on the login screen.
APP_PASSWORD=change-me

# Postgres connection string.
# Supabase: Project -> Connect -> "Transaction pooler" URI (port 6543).
DATABASE_URL=postgresql://postgres.xxxx:YOUR-DB-PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# --- Receipt photos (Supabase Storage) ---
# Supabase: Project Settings -> API. The service role key must stay secret.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Naver place search ---
# https://developers.naver.com -> Application -> register -> enable "Search" API.
# Without these, place search falls back to OpenStreetMap.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
